{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "primary": { "$type": "color", "$value": "#2A9D8F" },
    "accent": { "$type": "color", "$value": "#F4A261" },
    "danger": { "$type": "color", "$value": "#E76F51" }
  },
  "color": {
    "light": {
      "bg.page": { "$type": "color", "$value": "#FFF7EC" },
      "bg.surface": { "$type": "color", "$value": "#FFFFFF" },
      "bg.subtle": { "$type": "color", "$value": "#F8F2E9" },
      "text.primary": { "$type": "color", "$value": "#2B2B2B" },
      "text.secondary": { "$type": "color", "$value": "#5F5750" },
      "text.tertiary": { "$type": "color", "$value": "#8A817A" },
      "border.default": { "$type": "color", "$value": "#E6DCCD" },
      "action.primary.bg": { "$type": "color", "$value": "#F4A261" },
      "action.secondary.bg": { "$type": "color", "$value": "#2A9D8F" }
    },
    "dark": {
      "bg.page": { "$type": "color", "$value": "#0F1716" },
      "bg.surface": { "$type": "color", "$value": "#162220" },
      "bg.subtle": { "$type": "color", "$value": "#1C2B28" },
      "text.primary": { "$type": "color", "$value": "#F7F3EE" },
      "text.secondary": { "$type": "color", "$value": "#D8D0C7" },
      "text.tertiary": { "$type": "color", "$value": "#AAA297" },
      "border.default": { "$type": "color", "$value": "#2E423F" },
      "action.primary.bg": { "$type": "color", "$value": "#F4A261" },
      "action.secondary.bg": { "$type": "color", "$value": "#2A9D8F" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": 4 },
    "sm": { "$type": "dimension", "$value": 8 },
    "md": { "$type": "dimension", "$value": 12 },
    "lg": { "$type": "dimension", "$value": 16 },
    "xl": { "$type": "dimension", "$value": 24 },
    "2xl": { "$type": "dimension", "$value": 32 },
    "3xl": { "$type": "dimension", "$value": 48 },
    "4xl": { "$type": "dimension", "$value": 64 }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": 8 },
    "sm": { "$type": "dimension", "$value": 12 },
    "md": { "$type": "dimension", "$value": 16 },
    "lg": { "$type": "dimension", "$value": 20 },
    "xl": { "$type": "dimension", "$value": 24 },
    "pill": { "$type": "dimension", "$value": 999 }
  },
  "typography": {
    "h1": { "$type": "typography", "$value": { "fontSize": 34, "lineHeight": 40, "fontWeight": 800 } },
    "h2": { "$type": "typography", "$value": { "fontSize": 28, "lineHeight": 34, "fontWeight": 800 } },
    "h3": { "$type": "typography", "$value": { "fontSize": 22, "lineHeight": 28, "fontWeight": 700 } },
    "body": { "$type": "typography", "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": 400 } },
    "label": { "$type": "typography", "$value": { "fontSize": 14, "lineHeight": 18, "fontWeight": 700 } },
    "caption": { "$type": "typography", "$value": { "fontSize": 12, "lineHeight": 16, "fontWeight": 500 } }
  }
}

